{
  "version": 1,
  "hooks": {
    "SessionStart": [
      {
        "command": "CHANGEFORGE_AGENT=copilot /usr/bin/env python3 \"${HOME}/.copilot/hooks/changeforge/changeforge_session_bootstrap.py\"",
        "timeoutSec": 10
      }
    ],
    "PreToolUse": [
      {
        "command": "CHANGEFORGE_AGENT=copilot /usr/bin/env python3 \"${HOME}/.copilot/hooks/changeforge/changeforge_sdd_material_choice_gate.py\"",
        "timeoutSec": 10
      },
      {
        "command": "CHANGEFORGE_AGENT=copilot /usr/bin/env python3 \"${HOME}/.copilot/hooks/changeforge/changeforge_pre_edit_structure_gate.py\"",
        "timeoutSec": 10
      },
      {
        "command": "CHANGEFORGE_AGENT=copilot /usr/bin/env python3 \"${HOME}/.copilot/hooks/changeforge/changeforge_permission_policy_gate.py\"",
        "timeoutSec": 10
      }
    ],
    "PostToolUse": [
      {
        "command": "CHANGEFORGE_AGENT=copilot /usr/bin/env python3 \"${HOME}/.copilot/hooks/changeforge/changeforge_post_tool_collector.py\"",
        "timeoutSec": 10
      }
    ],
    "PostToolUseFailure": [
      {
        "command": "CHANGEFORGE_AGENT=copilot /usr/bin/env python3 \"${HOME}/.copilot/hooks/changeforge/changeforge_post_tool_collector.py\"",
        "timeoutSec": 10
      }
    ],
    "SubagentStart": [
      {
        "command": "CHANGEFORGE_AGENT=copilot /usr/bin/env python3 \"${HOME}/.copilot/hooks/changeforge/changeforge_subagent_review_gate.py\"",
        "timeoutSec": 10
      }
    ],
    "SubagentStop": [
      {
        "command": "CHANGEFORGE_AGENT=copilot /usr/bin/env python3 \"${HOME}/.copilot/hooks/changeforge/changeforge_subagent_review_gate.py\"",
        "timeoutSec": 10
      }
    ],
    "PreCompact": [
      {
        "command": "CHANGEFORGE_AGENT=copilot /usr/bin/env python3 \"${HOME}/.copilot/hooks/changeforge/changeforge_compaction.py\"",
        "timeoutSec": 10
      }
    ],
    "Stop": [
      {
        "command": "CHANGEFORGE_AGENT=copilot /usr/bin/env python3 \"${HOME}/.copilot/hooks/changeforge/changeforge_stop_closure_gate.py\"",
        "timeoutSec": 10
      }
    ]
  }
}
